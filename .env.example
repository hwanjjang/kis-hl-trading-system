PORT=3000
HOST=0.0.0.0
LOG_LEVEL=INFO
DATA_DIR=data

# KIS uses sandbox credentials unless SANDBOX=false.
SANDBOX=true
KIS_API_ST_KEY=replace_me
KIS_API_ST_SECRET=replace_me
KIS_ST_STOCK_ACCOUNT=0000000000
KIS_API_KEY=replace_me
KIS_API_SECRET=replace_me
KIS_STOCK_ACCOUNT=0000000000
KIS_HTSID=replace_me
KIS_TOKEN_DIR=data/kis-tokens
KIS_MIN_REQUEST_INTERVAL_MS=300
KIS_RATE_LIMIT_RETRIES=2
KIS_RATE_LIMIT_DELAY_MS=500
KIS_WS_ST_URL=ws://ops.koreainvestment.com:31000
KIS_WS_URL=ws://ops.koreainvestment.com:21000

# Hyperliquid default profile. Use an approved API wallet for automation.
HYPERLIQUID_KEY_PROFILE=default
HYPERLIQUID_WALLETADDRESS=0x0000000000000000000000000000000000000000
HYPERLIQUID_PRIVATEKEY=0xreplace_me
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Optional production key profile, selected with HYPERLIQUID_KEY_PROFILE=production.
PRO_HYPERLIQUID_WALLETADDRESS=0x0000000000000000000000000000000000000000
PRO_HYPERLIQUID_PRIVATEKEY=0xreplace_me
