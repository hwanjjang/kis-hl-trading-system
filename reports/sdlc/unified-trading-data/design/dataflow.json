  "flows": [
    {
      "id": "capture_accounts",
      "from": "account_sources",
      "to": "account_evidence",
      "label": "Responses",
      "variant": "emphasis"
    },
    {
      "id": "normalize_accounts",
      "from": "account_evidence",
      "to": "account_facts",
      "label": "Normalize",
      "variant": "emphasis"
    },
    {
      "id": "check_accounts",
      "from": "account_facts",
      "to": "account_checks",
      "label": "Reconcile",
      "variant": "emphasis"
    },
    {
      "id": "publish_journal",
      "from": "account_checks",
      "to": "journal_exports",
      "label": "Net results",
      "variant": "emphasis"
    },
    {
      "id": "capture_markets",
      "from": "market_sources",
      "to": "market_evidence",
      "label": "Observations"
    },
    {
      "id": "normalize_markets",
      "from": "market_evidence",
      "to": "market_facts",
      "label": "Normalize"
    },
    {
      "id": "check_markets",
      "from": "market_facts",
      "to": "market_checks",
      "label": "Validate"
    },
    {
      "id": "analyze_markets",
      "from": "market_checks",
      "to": "analysis_outputs",
      "label": "Pinned bars"
    },
    {
      "id": "analyze_trades",
      "from": "journal_exports",
      "to": "analysis_outputs",
      "label": "Pinned trade results",
      "variant": "dashed",
      "labelAt": [
        960,
        271
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One canonical SQLite store",
      "items": [
        "Evidence, facts and projections share data/kis_hl.sqlite.",
        "Existing managed/trailing state keeps its database path and locks."
      ]
    },
    {
      "dot": "amber",
      "title": "Money and precision remain explicit",
      "items": [
        "Keep both-side fees, actual funding and unresolved allocations.",
        "KIS and tradefi stay separate; Master is excluded from journals."
      ]
    },
    {
      "dot": "emerald",
      "title": "Weekly history with provenance",
      "items": [
        "Target ten years where listing history and provider coverage allow.",
        "Calendar, adjustment basis and input revisions travel with each bar."
      ]
    }
  ]
}