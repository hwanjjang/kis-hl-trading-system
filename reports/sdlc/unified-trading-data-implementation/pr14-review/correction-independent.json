      "reproduction_script": "import json\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nfrom kis_hl.data_store import DataStore\nfrom kis_hl.data_ingestion import ingest_rows\nfrom kis_hl.journal_exports import journal\nDAY=86400000\n\ndef row(i,day,side,q,**extra):\n    return dict(source_id=str(i),instrument='kis:X',currency='USD',event_start_ms=day*DAY,event_end_ms=(day+1)*DAY,time_precision='DAY',grain='DAY',side=side,quantity=str(q),price='100',notional=str(q*100),total_cost='1',costs={'broker':'1'},**extra)\ndef run(rows):\n    with TemporaryDirectory() as td:\n        store=DataStore(Path(td)/'probe.sqlite'); account=store.account('kis','sim','probe')\n        ingest_rows(store,account,'statement',rows)\n        store.coverage('trade',account,0,10**15,'complete',{})\n        result=journal(store,[account])\n        return {'cycles':[{k:c[k] for k in ('status','side','opened_ms','closed_ms','reasons','net_return_pct')} for c in result['cycles']], 'findings':result['quality_findings'],'summary':result['summary_by_account_currency']}\nprobes={\n 'prior_good_then_ambiguous':run([row(1,1,'buy',1,position_before='0',day_end_quantity='1'),row(2,2,'sell',1,day_end_quantity='0'),row(3,3,'buy',1),row(4,3,'sell',1)]),\n 'day_mismatch_then_oversell':run([row(1,1,'buy',1,position_before='0',day_end_quantity='1'),row(2,2,'sell',1,position_before='1',day_end_quantity='7'),row(3,2,'sell',2,day_end_quantity='7')]),\n 'prior_good_then_day_mismatch':run([row(1,1,'buy',1,position_before='0',day_end_quantity='1'),row(2,2,'sell',1,day_end_quantity='0'),row(3,3,'buy',1,day_end_quantity='7')]),\n}\nprint(json.dumps(probes,indent=2))\n"
