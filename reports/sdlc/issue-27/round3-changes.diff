+                        case.worker.step(case.row["id"], tick)
+                        self.assertEqual(case.store.tranches(case.row["id"])[0]["status"], "REJECTED")
+                        self.assertFalse(any(a["kind"] in {"add", "cancel"} for a in case.g.sent))
+                    finally:
