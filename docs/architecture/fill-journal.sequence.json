  "cards": [
    {
      "dot": "emerald",
      "title": "Protection first",
      "items": [
        "The supervisor only writes a local request after its state commit",
        "No network IO inside the account lock; a failed write is logged and ignored",
        "Paper owners never fill, so they never request"
      ]
    },
    {
      "dot": "amber",
      "title": "Retry and fallback",
      "items": [
        "Failures back off 30 s, doubling to 15 min, until a success clears them",
        "A fill during a sync keeps the request pending for another pass",
        "Account jobs journal manual fills at the fallback interval"
      ]
    },
    {
      "dot": "violet",
      "title": "Notification contract",
      "items": [
        "One batch row per sync; each journal_id is notified at most once",
        "A per-account baseline keeps historical journals silent",
        "Delivery is at least once; acknowledgement stays with Hermes"
      ]
    }
  ]
