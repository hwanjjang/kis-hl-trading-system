  "cards": [
    {
      "dot": "cyan",
      "title": "Key Per Connection",
      "items": [
        "The transport factory mints a listenKey before each socket open",
        "The maintained runner keeps a placeholder URL; the factory supplies the real one",
        "No listenKey is logged or printed"
      ]
    },
    {
      "dot": "orange",
      "title": "Bounded Renewal",
      "items": [
        "Keepalive on idle ticks every 30 minutes, under the 60 minute expiry",
        "listenKeyExpired raises inside the handler so the runner reconnects",
        "order_events keeps a venue column; this iteration places no orders"
      ]
