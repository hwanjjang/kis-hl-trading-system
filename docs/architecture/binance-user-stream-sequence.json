        "id": "renew",
        "label": "Keepalive and expiry",
        "focus": [
          "user_ws",
          "rest",
          "binance_rest",
          "binance_ws"
        ],
        "note": "Idle ticks renew the key; an expiry event forces a reconnect that mints a new key."
      }
    ]
