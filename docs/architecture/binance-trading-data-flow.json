  "cards": [
    {
      "dot": "cyan",
      "title": "Market Stream Evidence",
      "items": [
        "ws.py stream_route(): bookTicker/depth \u2192 /public, others \u2192 /market",
        "parse_market_ticks() maps mark, book, kline, aggTrade to PriceTick",
        "binance-stream stores ticks as source=binance, market=usdm_futures"
      ]
    },
    {
      "dot": "rose",
      "title": "Order Event Evidence",
      "items": [
        "client.py owns listenKey create / keepalive / close",
        "User stream requests an account key per connection; reconnects on listenKeyExpired",
        "storage.py order_events keeps ids, status, fills, raw payload"
      ]
    },
    {
      "dot": "orange",
      "title": "Trading Path Boundary",
      "items": [
        "Order placement is implemented; automated strategy execution remains planned",
        "Guard: explicit dry-run, MIN_NOTIONAL / tick / step filters, fail closed",
        "Server-side STOP_MARKET and TRAILING_STOP_MARKET use the Algo Order API"
      ]
    }
  ]
}
