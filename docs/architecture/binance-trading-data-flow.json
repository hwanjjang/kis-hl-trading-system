{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Binance Trading, Market Stream, and Order Event Flow",
    "locale": "en",
    "output": "docs/architecture/binance-trading-data-flow.html",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      520
    ],
    "views": [
      {
        "id": "market_stream",
        "label": "Market data over WebSocket",
        "focus": [
          "ws_market",
          "market_stream",
          "tick_parser",
          "sqlite",
          "strategy"
        ],
        "note": "Combined streams arrive per route tier, become PriceTicks, and land in market_ticks for signals."
      },
      {
        "id": "order_events",
        "label": "Order results over WebSocket",
        "focus": [
          "ws_private",
          "user_stream",
          "rest_client",
          "event_parser",
          "sqlite",
          "cli"
        ],
        "note": "A listenKey from REST opens the private stream; ORDER_TRADE_UPDATE frames become order_events rows."
      },
      {
        "id": "trading",
        "label": "Trading path",
        "focus": [
          "binance_rest",
          "rest_client",
          "order_guard",
          "sqlite",
          "strategy"
        ],
        "note": "Signed orders pass guards and REST; private events provide subsequent order updates."
      }
    ]
  },
  "stages": [
    {
      "label": "Binance"
    },
    {
      "label": "Acquire"
    },
    {
      "label": "Normalize & Guard"
    },
    {
      "label": "Persist"
    },
    {
      "label": "Consume"
    }
  ],
  "nodes": [
