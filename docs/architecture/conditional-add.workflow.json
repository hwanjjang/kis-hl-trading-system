    {
      "id": "protection",
      "label": "Combined Position Protection"
    },
    {
      "id": "terminal",
      "label": "Terminal Owner Cleanup"
    }
  ],
  "mainPath": [
    "condition",
    "authority",
    "tranche",
    "preflight",
    "attempt",
    "fills",
    "coverage",
    "exit",
