  "cards": [
    {
      "dot": "cyan",
      "title": "Durable ownership",
      "items": [
        "One account/instrument owner; per-tranche sizing and fill evidence",
        "UNKNOWN stays visible; reconcile actual fills without resending the add"
      ]
    },
    {
      "dot": "amber",
      "title": "Protection preserved",
      "items": [
        "SL/TS covers actual residuals while cancellation is reconciled",
        "Unsent retirement never hides a durable signed or UNKNOWN attempt"
      ]
    }
