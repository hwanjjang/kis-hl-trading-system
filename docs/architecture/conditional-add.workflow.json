  "edges": [
    {
      "id": "condition-authority",
      "from": "condition",
      "to": "authority"
    },
    {
      "id": "authority-tranche",
      "from": "authority",
      "to": "tranche"
    },
    {
      "id": "tranche-preflight",
      "from": "tranche",
      "to": "preflight"
    },
    {
      "id": "preflight-attempt",
      "from": "preflight",
      "to": "attempt"
    },
    {
      "id": "attempt-fills",
      "from": "attempt",
      "to": "fills"
    },
    {
      "id": "fills-coverage",
      "from": "fills",
      "to": "coverage"
    },
