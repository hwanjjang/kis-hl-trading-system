{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Binance Order Round Trip",
    "output": "docs/architecture/binance-order-roundtrip-sequence.html",
    "viewBox": [
      1080,
      560
    ],
    "quality_profile": "showcase",
    "column_fit": "spread",
    "views": [
      {
        "id": "guard",
        "label": "Guard before any signed call",
        "focus": [
          "strategy",
          "guard",
          "rest",
          "binance_rest"
        ],
        "note": "Filters and mark price are public reads; rounding and notional checks run first; dry-run returns the prepared request."
      },
      {
        "id": "submit",
        "label": "Submit only unless --dry-run",
        "focus": [
          "guard",
          "rest",
          "binance_rest",
          "sqlite"
        ],
        "note": "Allowlist, credentials, one-way mode and the account lock gate the signed POST; the raw ack is stored in order_submissions."
      },
      {
        "id": "confirm",
        "label": "Confirm over the user stream",
        "focus": [
          "binance_ws",
          "user_ws",
          "sqlite",
          "strategy"
        ],
        "note": "ORDER_TRADE_UPDATE frames are the fill source of truth; STOP_MARKET and TRAILING_STOP_MARKET live on the exchange."
      }
    ]
  },
  "participants": [
    {
      "id": "strategy",
      "type": "frontend",
      "label": "CLI",
      "sublabel": "binance-* commands"
    },
    {
      "id": "guard",
      "type": "security",
      "label": "Trading client",
      "sublabel": "BinanceTradingClient"
    },
    {
      "id": "rest",
      "type": "backend",
      "label": "REST client",
      "sublabel": "BinanceFuturesClient"
    },
    {
      "id": "binance_rest",
      "type": "external",
      "label": "Binance REST",
      "sublabel": "fapi /order"
    },
    {
      "id": "binance_ws",
      "type": "external",
      "label": "Binance WS",
      "sublabel": "fstream /private"
    },
    {
      "id": "user_ws",
      "type": "backend",
      "label": "User stream",
      "sublabel": "BinanceUserStreamClient"
    },
    {
      "id": "sqlite",
      "type": "database",
      "label": "SQLite",
      "sublabel": "submissions \u00b7 events"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 266,
      "label": "Validate (explicit dry-run)"
    },
    {
      "from": 276,
      "to": 390,
      "label": "Submit (default send)"
    },
    {
      "from": 400,
      "to": 486,
      "label": "Confirm over WebSocket"
    }
  ],
  "messages": [
    {
      "from": "strategy",
      "to": "guard",
      "y": 168,
      "label": "place_order / place_stop_market / place_trailing_stop",
      "variant": "emphasis"
    },
    {
      "from": "guard",
      "to": "rest",
      "y": 196,
      "label": "symbol_filters() + premium_index()",
      "variant": "default"
    },
    {
      "from": "rest",
      "to": "guard",
      "y": 224,
      "label": "tick \u00b7 step \u00b7 min notional \u00b7 mark price",
      "variant": "return"
    },
    {
      "from": "guard",
      "to": "strategy",
      "y": 252,
      "label": "dry_run submission: rounded params, no signed call",
      "variant": "return"
    },
    {
      "from": "guard",
      "to": "rest",
      "y": 292,
      "label": "symbol \u00b7 metadata \u00b7 mode \u00b7 lock",
      "variant": "security"
    },
    {
      "from": "rest",
      "to": "binance_rest",
      "y": 320,
      "label": "POST /fapi/v1/order or /algoOrder (HMAC, client id)",
      "variant": "security"
    },
    {
      "from": "binance_rest",
      "to": "rest",
      "y": 348,
      "label": "ack: orderId / algoId, error \u2192 rejected, 5xx \u2192 unknown",
      "variant": "return"
    },
    {
      "from": "rest",
      "to": "sqlite",
      "y": 376,
      "label": "order_submissions (+ protective_orders for stops)",
      "variant": "emphasis"
    },
    {
      "from": "binance_ws",
      "to": "user_ws",
      "y": 416,
      "label": "ORDER_TRADE_UPDATE: NEW \u2192 FILLED",
      "variant": "dashed"
    },
    {
      "from": "user_ws",
      "to": "sqlite",
      "y": 444,
      "label": "store_order_event(parse_order_event)",
      "variant": "emphasis"
    },
    {
      "from": "sqlite",
      "to": "strategy",
      "y": 472,
      "label": "fill state \u2192 binance-order-events / strategy",
      "variant": "dashed"
    }
  ],
  "activations": [
    {
      "participant": "guard",
      "from": 162,
      "to": 258,
      "type": "security"
    },
    {
      "participant": "rest",
      "from": 190,
      "to": 230,
      "type": "backend"
    },
    {
      "participant": "guard",
      "from": 286,
      "to": 298,
      "type": "security"
    },
    {
      "participant": "rest",
      "from": 286,
      "to": 382,
      "type": "backend"
    },
    {
      "participant": "binance_rest",
      "from": 314,
      "to": 354,
      "type": "external"
    },
    {
      "participant": "user_ws",
      "from": 410,
      "to": 450,
      "type": "backend"
    },
    {
      "participant": "sqlite",
      "from": 438,
      "to": 478,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "orange",
      "title": "Fail-Closed Order Path",
      "items": [
        "CLI sends by default; --dry-run previews without signed calls",
        "Validation and rounding run before any credential or signed call",
        "Live needs BINANCE_LIVE_SYMBOLS, credentials, one-way mode, and the account lock"
      ]
    },
    {
      "dot": "emerald",
      "title": "Fills Come From the Stream",
      "items": [
        "The REST ack only proves acceptance; fills arrive as ORDER_TRADE_UPDATE",
        "order_submissions and order_events are separate audit tables",
        "STOP_MARKET closePosition and TRAILING_STOP_MARKET run server-side via the Algo Order API"
      ]
    }
  ]
}
