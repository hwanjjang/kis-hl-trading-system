  "cards": [
    {
      "dot": "cyan",
      "title": "CLI handoff",
      "items": [
        "Hermes invokes the shared CLI; submit queues, never fills.",
        "Use --live on submit AND the separately running worker.",
        "Same DB/account; paper intents finish as PREVIEWED."
      ]
    },
    {
      "dot": "emerald",
      "title": "Default: native + local",
      "items": [
        "Partial fills get fixed SL. Terminal entry + verified SL allow one native trail.",
        "Native tracks mark; matching active readback confirms coverage. Local nine-minute tracking can start earlier.",
        "Keep the worker running for local exits, residual reconciliation and flat cleanup."
      ]
    },
    {
      "dot": "amber",
      "title": "Authority and limits",
      "items": [
        "Optional signal execute requires --manual OR a scoped --grant. Ingestion grants no authority.",
        "Preflight and authority precede entry. Exits use reduce-only orders and a shared attempt ledger.",
        "Live exchange contract unverified. Manual positions use order adopt."
      ]
    }
